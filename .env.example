# --- Green API (WhatsApp) ---
# Récupérés dans ton dashboard Green API (console.green-api.com)
GREEN_API_ID_INSTANCE=1101xxxxxx
GREEN_API_TOKEN_INSTANCE=votre_token_instance
# Laisser par défaut sauf si Green API t'a donné un domaine dédié
GREEN_API_BASE_URL=https://api.green-api.com
# Optionnel : token custom que tu ajoutes toi-même à l'URL du webhook
# (ex: https://ton-app.vercel.app/api/webhook?token=xxx) pour filtrer
# les appels non légitimes avant même de vérifier le numéro.
GREEN_API_WEBHOOK_TOKEN=

# --- Groq ---
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=openai/gpt-oss-120b

# --- Filtrage strict ---
# Le seul numéro auquel l'agent répondra (avec ou sans "+", peu importe)
ALLOWED_WHATSAPP_NUMBER=+2290144220259

# --- Personnalité de l'agence ---
AGENCY_NAME=Agence Bénin Immo
AGENT_FIRST_NAME=Awa

# --- Historique (optionnel, Upstash Redis REST) ---
# Laisser vide pour rester 100% stateless (recommandé pour la démo)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Prise de RDV automatique (Google Calendar, OAuth classique) ---
# Récupérés dans console.cloud.google.com > API et services > Identifiants
# (Créer des identifiants > ID client OAuth > type "Application de bureau")
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx
# Obtenu une seule fois via OAuth Playground (voir README.md pour la procédure)
GOOGLE_OAUTH_REFRESH_TOKEN=1//xxxxx
# "primary" pour ton calendrier principal, sinon l'ID du calendrier ciblé
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Africa/Porto-Novo

